
set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }
# The existing internal power-on reset is retained.
# HX1P35B_FT.pdf p2 BANK32 VCC_3V3; p7 GPIOB2..9 -> J2.3..10.
# SLP and RST have separate pads; never bridge these FPGA outputs.
set_pin_assignment {I_mcu_uart_rx} {LOCATION = J1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}
set_pin_assignment {O_mcu_uart_tx} {LOCATION = H1; IOSTANDARD = LVCMOS33;}
set_pin_assignment {O_motor_step[0]} {LOCATION = E12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_dir[0]} {LOCATION = E16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_awake[0]} {LOCATION = E17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_step[1]} {LOCATION = F13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_dir[1]} {LOCATION = F14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_awake[1]} {LOCATION = F18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_reset_n[0]} {LOCATION = G17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}
set_pin_assignment {O_motor_reset_n[1]} {LOCATION = H17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4;}

set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

set_pin_assignment	{ I_button[0] }			{ LOCATION = D5;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[1] }			{ LOCATION = A9;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[2] }			{ LOCATION = B9;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[3] }			{ LOCATION = C7;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment	{ I_detect_sw[0] }		{ LOCATION = A4;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_detect_sw[1] }		{ LOCATION = B4;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_detect_sw[2] }		{ LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_detect_sw[3] }		{ LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# 6-digit static/dynamic seven-segment display from the board example.
# Both buses are active low; only the first two digit selects are used by
# ua_exposure_seg6 (the remaining four digits are held off).
set_pin_assignment	{ O_seg_sel[0] }		{ LOCATION = G15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_sel[1] }		{ LOCATION = G14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_sel[2] }		{ LOCATION = A17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_sel[3] }		{ LOCATION = A18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_sel[4] }		{ LOCATION = B16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_sel[5] }		{ LOCATION = A15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[0] }		{ LOCATION = C9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[1] }		{ LOCATION = C11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[2] }		{ LOCATION = B11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[3] }		{ LOCATION = E7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[4] }		{ LOCATION = E6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[5] }		{ LOCATION = B6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[6] }		{ LOCATION = B7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_seg_led[7] }		{ LOCATION = E5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment	{ O_tmds_ch0_p }		{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }		{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }		{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }		{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }



